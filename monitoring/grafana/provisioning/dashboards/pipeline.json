{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Real-time de-identification pipeline performance: stage durations, cache hit rates, circuit breakers, job throughput.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Pipeline Stage Latency",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "s",
          "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "rule_evaluation" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "phi_detection" },    "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "pseudonymization" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "resource_assembly" },"properties": [{ "id": "color", "value": { "fixedColor": "#B877D9", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(medanon_pipeline_stage_duration_seconds_bucket{stage=\"rule_evaluation\"}[2m])) by (le))",
          "legendFormat": "rule_evaluation",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(medanon_pipeline_stage_duration_seconds_bucket{stage=\"phi_detection\"}[2m])) by (le))",
          "legendFormat": "phi_detection",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(medanon_pipeline_stage_duration_seconds_bucket{stage=\"pseudonymization\"}[2m])) by (le))",
          "legendFormat": "pseudonymization",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(medanon_pipeline_stage_duration_seconds_bucket{stage=\"resource_assembly\"}[2m])) by (le))",
          "legendFormat": "resource_assembly",
          "refId": "D"
        }
      ],
      "title": "Stage Duration — p50 (time-series)",
      "description": "phi_detection and pseudonymization run concurrently — their lines overlap when both are active. Sustained gap between them reveals which is the bottleneck.",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "s",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(medanon_pipeline_stage_duration_seconds_bucket{stage=\"rule_evaluation\"}[5m])) by (le))",
          "legendFormat": "rule_evaluation",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(medanon_pipeline_stage_duration_seconds_bucket{stage=\"phi_detection\"}[5m])) by (le))",
          "legendFormat": "phi_detection",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(medanon_pipeline_stage_duration_seconds_bucket{stage=\"pseudonymization\"}[5m])) by (le))",
          "legendFormat": "pseudonymization",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(medanon_pipeline_stage_duration_seconds_bucket{stage=\"resource_assembly\"}[5m])) by (le))",
          "legendFormat": "resource_assembly",
          "refId": "D"
        }
      ],
      "title": "Stage Duration — p95 (current)",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 101,
      "title": "gPAS Pseudonymization",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "unit": "percentunit",
          "min": 0, "max": 1
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 11 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(medanon_gpas_cache_hits_total[5m]) / (rate(medanon_gpas_cache_hits_total[5m]) + rate(medanon_gpas_cache_misses_total[5m]) + 0.001)",
          "legendFormat": "gPAS cache hit rate",
          "refId": "A"
        }
      ],
      "title": "gPAS Cache Hit Rate",
      "description": "High hit rate (>90%) means the pseudonymization stage is near-zero latency. Low hit rate means every chunk hits the gPAS service over HTTP.",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 5, "w": 10, "x": 6, "y": 11 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(medanon_gpas_duration_seconds_bucket[2m])) by (le, operation))",
          "legendFormat": "p50 {{operation}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(medanon_gpas_duration_seconds_bucket[2m])) by (le, operation))",
          "legendFormat": "p95 {{operation}}",
          "refId": "B"
        }
      ],
      "title": "gPAS HTTP Call Latency",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 11 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(medanon_gpas_calls_total{status=\"ok\"}[2m])) by (operation)",
          "legendFormat": "ok — {{operation}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(medanon_gpas_calls_total{status=\"error\"}[2m])) by (operation)",
          "legendFormat": "error — {{operation}}",
          "refId": "B"
        }
      ],
      "title": "gPAS Call Rate",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "NLP PHI Detection",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          },
          "unit": "percentunit",
          "min": 0, "max": 1
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 17 },
      "id": 6,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(medanon_nlp_cache_hits_total[5m]) / (rate(medanon_nlp_cache_hits_total[5m]) + rate(medanon_nlp_cache_misses_total[5m]) + 0.001)",
          "legendFormat": "NLP cache hit rate",
          "refId": "A"
        }
      ],
      "title": "NLP Detection Cache Hit Rate",
      "description": "Texts already seen (same patient, same narrative) return from cache without calling the NLP service. Low rate on first run of a new dataset is expected.",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 17 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(medanon_nlp_cache_hits_total[2m])",
          "legendFormat": "cache hits/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(medanon_nlp_cache_misses_total[2m])",
          "legendFormat": "cache misses/s (NLP HTTP calls)",
          "refId": "B"
        }
      ],
      "title": "NLP Detection Rate (cache hits vs HTTP calls)",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 103,
      "title": "Jobs and Throughput",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 23 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "medanon_worker_active_jobs",
          "legendFormat": "active jobs",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(medanon_worker_jobs_total[5m])) by (status)",
          "legendFormat": "{{status}} jobs/s",
          "refId": "B"
        }
      ],
      "title": "Worker — Active Jobs and Completion Rate",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 23 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(medanon_proxy_retries_total[2m])) by (upstream, reason)",
          "legendFormat": "{{upstream}} — {{reason}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Retry Rate by Upstream",
      "description": "Sustained retries indicate an upstream service (gPAS, NLP) is degraded or overloaded.",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 104,
      "title": "Reliability — Circuit Breakers and Bulkheads",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "CLOSED" }, "1": { "text": "HALF-OPEN" }, "2": { "text": "OPEN" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 30 },
      "id": 10,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "medanon_circuit_breaker_state",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Circuit Breaker States (0=CLOSED ✓, 1=HALF-OPEN, 2=OPEN ✗)",
      "description": "OPEN means all calls to that upstream are blocked and failing fast. HALF-OPEN means recovery is being probed.",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 30 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(medanon_bulkhead_rejected_total[2m])) by (upstream)",
          "legendFormat": "rejected — {{upstream}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(medanon_bulkhead_acquired_total[2m])) by (upstream)",
          "legendFormat": "acquired — {{upstream}}",
          "refId": "B"
        }
      ],
      "title": "Bulkhead Pressure — Acquired vs Rejected per Upstream",
      "description": "Sustained rejections mean the upstream is saturated. Raise BULKHEAD_<NAME>_MAX_CONCURRENT or scale the upstream service.",
      "type": "timeseries"
    }

  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["medanon", "pipeline", "performance"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Datasource"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MedAnon — De-identification Pipeline",
  "uid": "medanon-pipeline-perf",
  "version": 1
}
