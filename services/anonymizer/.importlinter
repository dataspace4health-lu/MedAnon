# import-linter layering contract for the anonymizer service.
#
# Enforces the intended hexagonal dependency direction: dependencies point
# DOWNWARD only (interface -> application -> transforms -> adapters -> foundation).
# An import that reaches UP a layer breaks the contract.
#
# The `ignore_imports` list below is a BASELINE RATCHET. Every entry is a known,
# pre-existing upward import (22 of them, from the 2026-07 dependency audit). CI
# is green today because they are ignored, but any NEW upward import fails the
# build. As each violation is fixed in the coupling refactor, DELETE its line
# here; the contract tightens automatically and can never regress.
#
# Run:  make lint-imports   (from repo root)
# Or:   cd services/anonymizer && PYTHONPATH=src lint-imports

[importlinter]
root_packages =
    api
    pipeline
    actions
    integrations
    analytics
    utils
    domain
    formats

[importlinter:contract:layering]
name = anonymizer layering (dependencies point downward)
type = layers
layers =
    api
    pipeline
    actions
    integrations
    analytics | utils | domain | formats
ignore_imports =
    integrations.ai.agents.config_generator -> pipeline.config.loader
    integrations.ai.agents.config_generator -> pipeline.deidentify
    integrations.ai.agents.pii_detector -> pipeline.deidentify
    integrations.postgres.trust_profile_store -> pipeline.trust_profile
    integrations.scoring.client -> pipeline.scoring.models
    integrations.storage.delivery -> pipeline.connectors
