# import-linter layering contract for the anonymizer service.
#
# Enforces the intended hexagonal dependency direction: dependencies point
# DOWNWARD only (interface -> application -> transforms -> adapters -> foundation).
# An import that reaches UP a layer breaks the contract.
#
# There are NO ignore_imports: the coupling refactor cleared all 22 upward edges
# from the 2026-07 dependency audit, so the contract is enforced at zero. Any new
# upward import fails the build. Do not add ignore_imports back - fix the import
# direction instead (move the shared type down into domain/utils, or invert with
# a port injected at the composition root).
#
# Run:  make lint-imports   (from repo root)
# Or:   cd services/anonymizer && PYTHONPATH=src lint-imports

[importlinter]
root_packages =
    api
    pipeline
    actions
    integrations
    analytics
    utils
    domain
    formats

[importlinter:contract:layering]
name = anonymizer layering (dependencies point downward)
type = layers
layers =
    api
    pipeline
    actions
    integrations
    analytics | utils | domain | formats
