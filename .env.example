# =============================================================================
# MedAnon  deployment configuration
# =============================================================================
#
#   cp .env.example .env      # then fill in every REPLACE_WITH_* below
#   make env-check            # verify this file against the code and compose
#
# This file carries only what an operator must set or should consciously
# review. It is NOT the full catalogue: the code and docker-compose.yml read
# ~400 variables, almost all of them tuning knobs with sane defaults.
#
#   Full catalogue:  docs/reference/env-vars.md   (generated; do not hand-edit)
#   Regenerate it:   python3 scripts/check_env.py --docs docs/reference/env-vars.md
#
# Values below mirror the docker-compose.yml default, so `make up` behaves the
# same whether or not you override them. `make env-check` fails on any silent
# divergence; annotate a deliberate one with `# env-check: differs <reason>`.
#
# Do not put a bare `$` in a value. Compose expands it: `/{type}/$validate`
# reaches the container as `/{type}/`.
# =============================================================================


# =============================================================================
# 1. REQUIRED  the stack will not start, or is insecure, without these
# =============================================================================

# HMAC-SHA3-256 key for the `cryptohash` action. Without it, hashes are
# unkeyed SHA3 and reversible by rainbow table (GDPR Art. 4(5) failure).
#   openssl rand -hex 32
# env-check: differs placeholder  compose defaults to empty so the code can
# emit its own "no key configured" warning rather than start with a fake key.
MEDANON_HASH_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32

# Redis requires a password. MEDANON_REDIS_URL must embed the same value.
#   openssl rand -hex 24
MEDANON_REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MEDANON_REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379/0

# Postgres passwords. Distinct per database.
HAPI_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
HAPI_TARGET_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# env-check: differs placeholder  compose falls back to a dev password.
GPAS_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MEDANON_APP_DB_USER=medanon
# env-check: differs placeholder  compose falls back to a dev password.
MEDANON_APP_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# gPAS pseudonymisation service. See docs/DEPLOYMENT.md for domain setup;
# `make init-domains` imports the bundled domain template.
GPAS_URL=http://gpas-lb:80/ttp-fhir/fhir/gpas
GPAS_DOMAIN=spe.direct.resource-id
GPAS_OPERATION=pseudonymizeAllowCreate
GPAS_TIMEOUT_SEC=30
# env-check: differs placeholder  compose leaves gPAS basic-auth unset.
GPAS_BASIC_USER=user@ths
# env-check: differs placeholder  compose leaves gPAS basic-auth unset.
GPAS_BASIC_PASS=REPLACE_WITH_STRONG_PASSWORD

# API surface.
MEDANON_CORS_ORIGINS=http://localhost:8000,http://localhost:8080,http://localhost:8081,http://localhost:8082
MEDANON_MAX_BODY_BYTES=10485760


# =============================================================================
# 2. PRIVACY POSTURE  these change what the engine releases. Read them.
# =============================================================================

# Master switch. `true` turns every soft-release knob below into a hard
# requirement: the output barrier cannot be disabled, the raw PII scan cannot
# be skipped, NER detections block, the identifier gate cannot be set to warn,
# and `cryptohash` refuses to run without MEDANON_HASH_KEY.
MEDANON_REGULATED_MODE=false

# Output barrier (pipeline/validation.py). Runs at the process_data_batch
# choke point every caller shares. Disable only for a throughput-only pipeline
# over externally-trusted input.
MEDANON_OUTPUT_GATE_ENABLED=true

# Raw-resource PII scan, the barrier's first half. Two complementary checks:
#   structural  a HIPAA-sensitive path present in the output with no recorded
#                transformation. Deterministic. Requires MEDANON_MANIFEST_ENABLED.
#   content     regex + NER over free text (strings >= 15 chars only, so it
#                cannot see a leaked `name.family`; that is the structural
#                check's job).
MEDANON_PII_GATE=true

# Severities that hard-block, for BOTH checks. `critical,high` covers the HIPAA
# Safe Harbor direct identifiers. Adding `medium` also blocks untransformed
# dates/periods and Reference.display, which false-positives on date-shift
# pipelines that legitimately retain day precision.
MEDANON_PII_GATE_BLOCK_SEVERITY=critical,high

# Whether NER content detections block (`block`) or are advisory (`warn`).
# NER is the same Presidio model that just scrubbed the text, and it reads drug
# names, eponyms and hospital names as PERSON/LOCATION. Regex and structural
# detections are deterministic and always block. Forced to `block` in
# regulated mode.
MEDANON_PII_GATE_NER_MODE=warn

# Score-summary gate behaviour on a HIPAA coverage gap (sensitive field present
# but uncovered). `warn` releases when no PII was actually detected.
MEDANON_GATE_IDENTIFIER_MODE=block

# Record which rule transformed which path. The structural half of the output
# barrier reads this; with it off, that check is skipped (it cannot tell "no
# rule fired" from "nothing was recorded").
MEDANON_MANIFEST_ENABLED=true

# Privacy x utility x quality scoring, plus processing-run persistence.
MEDANON_SCORING_ENABLED=false

# `true` raises at config load on a rule-schema violation instead of warning.
# All bundled profiles pass strict.
MEDANON_RULE_SCHEMA_STRICT=false

# What an nlp_scrub / nlp_detect_act rule does when the NLP service is
# unreachable. `redact` blanks the field (fail-closed on data); `raise` fails
# the batch (fail-closed on process).
MEDANON_NLP_FAIL_MODE=redact

# Permit unkeyed SHA3 for `cryptohash`. Local development and tests only.
MEDANON_HASH_ALLOW_PLAIN=false

# Job-store durability. The `worker` container always refuses SQLite (it shares
# /output across containers, where WAL is unsafe). Set REQUIRE_DURABLE_STORE
# to make the API refuse it too. ALLOW_SQLITE_FALLBACK is a single-container
# local-dev override and nothing else.
MEDANON_REQUIRE_DURABLE_STORE=false
MEDANON_ALLOW_SQLITE_FALLBACK=false

# AI: never send PHI to an external model. PII_REQUIRE_LOCAL pins the PII-scan
# model to a loopback/private endpoint (fail-closed). REQUIRE_LOCAL extends
# that to every LLM call, including config generation.
MEDANON_AI_PII_REQUIRE_LOCAL=true
MEDANON_AI_REQUIRE_LOCAL=false

# Pre-privacy Trust Gate barrier. No-op unless TRUST_GATE_SERVICE_URL is set.
TRUST_GATE_MODE=warn


# =============================================================================
# 3. AUTH
# =============================================================================

# auto (legacy) | apikey | oidc | none
MEDANON_AUTH_PROVIDER=auto
# With this set, every endpoint except /health /ready /metrics /docs requires
# an X-API-Key header. Unset = open mode.
MEDANON_API_KEY=


# =============================================================================
# 4. SERVICE TOPOLOGY
# =============================================================================
#
# NLP_SERVICE_URL is hardcoded to http://nlp-lb:8200 in docker-compose.yml and
# is not settable here. `gpas-lb` and `nlp-lb` are Traefik aliases.

# Strangler-fig opt-outs: set a URL to delegate to the microservice.
SCORING_SERVICE_URL=http://scoring:8300
ANALYTICS_SERVICE_URL=
AI_SERVICE_URL=

# Trust Gate (docker compose --profile trust). Empty = the intake gate no-ops.
TRUST_GATE_SERVICE_URL=
# The bundled validator is the HL7/Inferno validator-wrapper on :4567.
# For a HAPI sidecar instead, use http://fhir-validator:8080/fhir and
# /{type}/\$validate  note the backslash; a bare $ is expanded by compose.
TRUST_GATE_VALIDATOR_URL=http://fhir-validator:4567
TRUST_GATE_VALIDATOR_ENDPOINT=/validate


# =============================================================================
# 5. CAPACITY  see docs/RUNBOOK.md before raising these
# =============================================================================
#
# MEDANON_PARALLEL_WORKERS dispatches per-resource rule evaluation to a thread
# pool. The match stage is pure-Python and GIL-bound, so this buys little and
# costs task overhead. Scale horizontally (`--scale worker=N`) instead.

MEDANON_BATCH_SIZE=1000
MEDANON_PARALLEL_WORKERS=4
MEDANON_GLOBAL_MAX_THREADS=128
MEDANON_WORKERS=4
MEDANON_JOB_WORKERS=3
MEDANON_REQUEST_TIMEOUT_SEC=120

# A single gPAS replica wedges when over-driven. These caps are the fix.
GPAS_MAX_BATCH_SIZE=2000
GPAS_SUBBATCH_PARALLEL=4
BULKHEAD_GPAS_MAX_CONCURRENT=32
BULKHEAD_NLP_MAX_CONCURRENT=16

# Two-phase staging + bulk-export shape.
MEDANON_STAGING_BATCH_SIZE=5000
MEDANON_OUTPUT_MODE=shards


# =============================================================================
# 6. OPT-IN PROFILES
# =============================================================================
# Each block is inert unless you start the stack with the matching profile:
#   docker compose --profile auth up      (Keycloak)
#   docker compose --profile s3 up        (MinIO)
#   docker compose --profile ai up        (Ollama)
#   docker compose --profile mq up        (RabbitMQ)
#   docker compose --profile monitoring up

# --- profile: auth -----------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- profile: s3 -------------------------------------------------------------
# Compose hard-fails (${VAR:?}) when the s3 profile is up and these are unset.
# env-check: differs placeholder  the shared anchor defaults them to empty so
# the stack starts without the s3 profile; the profile itself demands them.
MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
# env-check: differs placeholder  see MINIO_ROOT_USER above.
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- profile: ai -------------------------------------------------------------
MEDANON_AI_ENABLED=false
MEDANON_AI_PROVIDER=ollama/llama3.1
MEDANON_AI_API_BASE=http://ollama:11434
MEDANON_AI_API_KEY=
# Local-only model for the residual-PII scan. See MEDANON_AI_PII_REQUIRE_LOCAL.
MEDANON_AI_PII_PROVIDER=

# gPAS replicas. gPAS is the throughput floor for large exports: one instance
# is hard-capped at ~550 values/sec (serialised by a per-JVM lock, not the DB),
# and instances scale ~linearly (2 measured ~1.8x; cold 130k export 993s -> 648s).
# Costs ~1.3 GB RAM each - set to 1 on memory-constrained hosts.
GPAS_REPLICAS=2
