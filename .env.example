# Copy this file to .env and fill in secrets before running make up.
#
# SECURITY NOTICE:
# Never commit real secrets or credentials to version control.
# Always use environment variables for all sensitive values (passwords, tokens, API keys, etc.).
# For production, rotate secrets regularly and use a secure secret manager if possible.
# Values here use Docker-internal DNS names — they work inside the fhir-net bridge.
# For host access (e.g. curl from your laptop) use the host IP or localhost with the mapped port.

# ── Anonymizer ────────────────────────────────────────────────────────────────
MEDANON_CORS_ORIGINS=http://localhost:8000,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8501
MEDANON_MAX_BODY_BYTES=10485760

# Rate limiting (slowapi). Set to false for local dev or when a reverse proxy
# already enforces rate limits upstream.
MEDANON_RATE_LIMIT_ENABLED=true
# Per-endpoint rate limits (slowapi format: "N/interval", e.g. "200/minute").
# Only effective when MEDANON_RATE_LIMIT_ENABLED=true.
MEDANON_RATE_PROCESS=200/minute
MEDANON_RATE_NDJSON=60/minute
MEDANON_RATE_RAW=200/minute
MEDANON_RATE_BATCH=60/minute
MEDANON_RATE_FHIR_SERVER=30/minute
MEDANON_RATE_BULK_EXPORT=10/minute
MEDANON_RATE_UPLOAD=60/minute

# HMAC-SHA3-256 key for the cryptohash action.
# Without this, hashes are plain SHA3-256 — reversible via rainbow tables, NOT production-safe.
# Generate with: openssl rand -hex 32
MEDANON_HASH_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32

# Allow plain hashing without HMAC (ONLY for local dev/testing).
# When MEDANON_HASH_KEY is unset and this is NOT set to 'true', cryptohash will raise an error.
# Production deployments MUST use MEDANON_HASH_KEY; never set this to true in production.
# MEDANON_HASH_ALLOW_PLAIN=true

# RSA keys — absolute paths inside the container.
MEDANON_RSA_PUBLIC_KEY=/code/keys/id_rsa.pub
MEDANON_RSA_PRIVATE_KEY=/code/keys/id_rsa

# Colon-separated list of directories where RSA key files may reside (path-traversal guard).
# Defaults to MEDANON_CONFIG_DIR + /code/keys. Only needed if keys live elsewhere.
# MEDANON_KEY_ALLOWED_DIRS=/code/keys:/run/secrets

# Readiness probe timeout (seconds, default 5).
MEDANON_READY_TIMEOUT=5.0

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Number of gunicorn workers (default 4). Rule of thumb: 2 × CPU cores + 1.
# Only used in production (Docker). Dev mode uses uvicorn --reload (single worker).
MEDANON_WORKERS=4

# Controls whether the web server also runs an embedded job worker.
# In Docker (make up), the dedicated worker container handles all async jobs,
# so this is false. Set to true only for single-process local dev without Docker.
MEDANON_WORKER_ENABLED=false
# Port for the worker's Prometheus /metrics endpoint (worker container only).
# Set to 0 to disable. The anonymizer exposes metrics on its own port (/metrics).
MEDANON_WORKER_METRICS_PORT=9091

# Pre-warm Presidio + spaCy (en_core_web_lg, ~700 MB) at startup so the first
# NLP request is not blocked. With gunicorn multi-worker each process loads its
# own independent copy (no sharing across forks), so 4 workers = ~2.8 GB just
# for NLP models at startup. Set false to load lazily on first request instead
# (~5 s cold-start penalty per worker, once). In Docker the default is false
# (set in docker-compose.yml) to avoid OOM on hosts with limited RAM.
# Set true for single-process local dev where latency matters more than memory.
MEDANON_NLP_PREWARM=false

# Number of asyncio threads used for parallel in-process resource processing.
# Pass 1 (FHIRPath evaluation + action dispatch) runs in parallel when > 0.
# Default: min(CPU cores, 16). Set to 0 for sequential processing (debugging).
MEDANON_PARALLEL_WORKERS=8

# Include a per-resource transformation manifest in meta.tag.
# When true, each de-identified resource gets a meta.tag entry listing every
# rule that fired (action + FHIRPath). Required for the UI Resource Summary to
# show all de-identified fields and actions (including gpas_pseudonymize).
MEDANON_MANIFEST_ENABLED=true

# Config-independent "structural PHI" safety pass. When true, the engine also
# zeroes precise geolocation coordinates (latitude/longitude extensions) and
# redacts extension text labels (US Core race/ethnicity) on EVERY resource,
# regardless of your config rules. OFF by default so the config rules are the
# single source of truth — nothing is transformed without a matching rule. When
# enabled, each change is recorded in the manifest (action: structural_geo /
# structural_ext_text). The Config Builder's Resource Explorer flags geo/
# sensitive/base64 fields so you can add explicit rules instead.
MEDANON_STRUCTURAL_PHI_ENABLED=false

# Heuristic attachment scanner. When true, the NLP stage finds Attachment.data /
# *Base64Binary fields anywhere in a resource and scrubs embedded PHI even when
# no config rule targets them. OFF by default so the config rules are the single
# source of truth — nothing is scrubbed without a matching nlp_* rule. The
# Resource Explorer flags `base64` fields with a recommended treatment; add an
# explicit nlp_scrub rule with base64_encoded: true instead of relying on this.
MEDANON_ATTACHMENT_SCAN=false

# ── FHIR source server ────────────────────────────────────────────────────────
# URL of the FHIR server to fetch resources from.
# Docker-internal DNS: hapi-fhir:8080 — use this when running inside the stack.
FHIR_SOURCE_URL=http://hapi-fhir:8080/fhir
FHIR_SOURCE_TOKEN=

# ── FHIR target server ────────────────────────────────────────────────────────
# URL of the FHIR server to upload de-identified resources to.
# Docker-internal DNS: hapi-fhir-target:8080 — use this when running inside the stack.
FHIR_TARGET_URL=http://hapi-fhir-target:8080/fhir
FHIR_TARGET_TOKEN=
# De-identification profile used by /process/and-upload and /process/round-trip.
# structural = keeps full FHIR structure, pseudonymizes IDs via gPAS, rewrites all
# internal references so the target server resolves them correctly.
# Other options: auto, minimal, gpas, gdpr, hipaa, research.
MEDANON_TARGET_CONFIG_PROFILE=structural

# HAPI server public address (used in Bundle fullUrl and pagination links).
HAPI_SERVER_ADDRESS=http://hapi-fhir:8080/fhir

# FHIR HTTP client tuning
FHIR_RETRY_COUNT=2
FHIR_RETRY_BACKOFF_SEC=0.3
# Maximum pages followed during paginated search / $everything / bulk export download.
FHIR_MAX_PAGES=1000
# Page size for paginated FHIR search (_count per GET). Larger = fewer round-trips.
FHIR_PAGE_SIZE=500

# FHIR $bulk-export polling
# How long to wait between poll attempts (seconds).
FHIR_BULK_POLL_INTERVAL_SEC=2
# Total time to wait for a bulk export to complete before giving up (seconds).
FHIR_BULK_POLL_TIMEOUT_SEC=3600

# ── gPAS pseudonymization ─────────────────────────────────────────────────────
# Routes through the Traefik gateway, which exposes the legacy ``gpas-lb``
# network alias on port 80.  Traefik load-balances across all running gpas
# replicas (round-robin); JSF web UI requests are sticky-cookied to one replica.
# When running with --scale gpas=N use the same URL — Traefik discovers new
# replicas automatically via Docker labels.
GPAS_URL=http://gpas-lb:80/ttp-fhir/fhir/gpas
# GPAS_DOMAIN is the fallback domain for resource types not listed in the domain_map
# (config_gpas.yaml general.domain_map). All 74 standard FHIR R4 types are mapped to
# specific spe.* leaf domains; this value only applies to unknown/custom resource types.
# It must exist in gPAS — the bundled SQL init creates all spe.* domains automatically.
GPAS_DOMAIN=spe.direct.resource-id
GPAS_OPERATION=pseudonymizeAllowCreate
GPAS_TIMEOUT_SEC=30
GPAS_ADMIN_URL=
GPAS_TOKEN=
# gPAS authentication uses the format  username@domain  (the domain is always "ths").
#   Standard API user (role.gpas.user):   user@ths
#   Admin (role.gpas.admin + user):        admin@ths
# The password is seeded by services/gpas/sqls/02_init_database_gras_for_gpas.sql.
# Change the SQL script password AND this value before any non-local deployment.
# Generate with: openssl rand -base64 24
GPAS_BASIC_USER=user@ths
GPAS_BASIC_PASS=REPLACE_WITH_STRONG_PASSWORD
GPAS_CACHE_ENABLED=true
# L1 gPAS pseudonym cache size (entries across all 8 shards, ~150 bytes each).
# Size to cover your full working set: a 130K-resource export touches ~300K–400K
# unique values (IDs + cross-resource references). Default 300K ≈ 45 MB RAM.
# When MEDANON_REDIS_URL is set, L1 evictions are served from Redis L2 (~1 ms)
# instead of gPAS HTTP (~150 ms) — no gPAS calls for warm cached values.
MEDANON_CACHE_MAX_ENTRIES=300000
GPAS_RETRY_COUNT=2
GPAS_RETRY_BACKOFF_SEC=0.2

# Circuit breaker — prevents cascading failures when gPAS is down.
GPAS_CB_FAILURE_THRESHOLD=5
GPAS_CB_RECOVERY_TIMEOUT_SEC=30
GPAS_CB_WINDOW_SEC=60
# Number of concurrent probe requests allowed in HALF_OPEN state before
# deciding to close or reopen the breaker.
GPAS_CB_HALF_OPEN_PROBES=3

# ── Scoring (post-export summary) ─────────────────────────────────────────────
# Enable automatic scoring on all de-identification endpoints.
# When true, every /process, /process/ndjson, /process/batch, /from-server,
# /everything, /round-trip, /bulk-export, /cohort endpoint scores results and
# persists processing run metadata to the app-db (requires PostgreSQL).
# Manifests are auto-attached when scoring is on.
MEDANON_SCORING_ENABLED=false
# NER scan inside the scorer runs Presidio/NLP per resource — disabled here
# because the pipeline already scrubbed text before scoring.  Re-enabling it
# triggers one HTTP round-trip to nlp-lb per resource in the bulk-export hot loop
# (serial, not batched), which dominates post-export latency.
MEDANON_SCORE_NER_ENABLED=false
# Cap the patient reservoir for batch k-anonymity at job completion.
# 10000 (default) is statistically accurate but slow; 1000 is representative.
MEDANON_SCORE_MAX_PATIENTS=1000

# ── Trust Gate (pre-privacy quality barrier — opt-in `trust` profile) ─────────
# A standalone microservice that assesses incoming FHIR BEFORE privacy
# transformation and emits a Quality Passport (PASS/CONDITIONAL_PASS/BLOCK).
# Scoring is grounded in the Kahn et al. (2016) data-quality framework
# (conformance/completeness/plausibility × verification/validation) and the
# OHDSI Data Quality Dashboard methodology (violation-rate vs per-check
# threshold; headline metric = % of checks passing). See docs/trust-gate.md.
# Start the stack with `--profile trust` and set the URL below to activate the
# intake barrier. Empty (default) = the intake gate is a no-op.
TRUST_GATE_SERVICE_URL=
# Enforcement mode (mirrors MEDANON_GATE_IDENTIFIER_MODE):
#   warn  (default) — always assess + attach the passport; never block.
#   block           — refuse BLOCK datasets with HTTP 422 before privacy runs.
#   off             — no-op.
TRUST_GATE_MODE=warn
# Decision-policy cut-offs (% of checks passing). Below PASS_MIN → CONDITIONAL;
# any Kahn category below CATEGORY_MIN → CONDITIONAL. A FAILed *critical* check
# (structural/profile invalidity) → BLOCK regardless.
TRUST_GATE_PASS_MIN_RATE=90
TRUST_GATE_CATEGORY_MIN_RATE=80
# Sidecars consumed by the trust-gate container (set on the service, not here).
# Default: the bundled HAPI sidecar's $validate (returns OperationOutcome).
# Recommended production validator: the HL7/Inferno validator-wrapper —
#   TRUST_GATE_VALIDATOR_URL=http://fhir-validator:4567
#   TRUST_GATE_VALIDATOR_ENDPOINT=/validate
TRUST_GATE_VALIDATOR_URL=http://fhir-validator:8080/fhir
TRUST_GATE_VALIDATOR_ENDPOINT=/{type}/$validate
# Opt-in Implementation-Guide conformance (conformance.ig_profile). Names an IG
# from services/trust-gate/config/ig_profiles.yaml (e.g. us_core); empty = the IG
# check is NA and the verdict is unchanged. Per-request override: assess `ig` field.
# Requires a validator that knows the IG's StructureDefinitions.
TRUST_GATE_IG_PROFILE=
# Override the IG profile map path (defaults to config/ig_profiles.yaml).
TRUST_GATE_IG_PROFILES_PATH=
# Terminology server is fail-soft: leave empty to skip code validation, or point
# at an operator-provided server (e.g. Snowstorm — needs Elasticsearch + a
# licensed SNOMED CT import; see docs/trust-gate.md). Validated (system,code)
# results are cached process-wide, so a single server is hit once per unique code.
TRUST_GATE_TERMINOLOGY_URL=
# uvicorn worker processes + matching CPU/memory limits for the Trust Gate. The
# assess path is CPU-bound under concurrent load (terminology results are cached
# process-wide), so throughput scales ~linearly with workers up to the cpu cap.
# Keep WORKERS == CPUS. Benchmarked: 2/2 ~1700 res/s vs 1/1 ~330 res/s on Synthea.
TRUST_GATE_WORKERS=2
TRUST_GATE_CPUS=2.0
TRUST_GATE_MEMORY=512M
# Host port for the standalone Trust Gate UI (opt-in `trust` profile). Paste FHIR
# → Quality Passport; runs separately from the main SPA on UI_PORT.
TRUST_GATE_UI_PORT=8401
# Clinical value-outlier detection (plausibility.value_outlier). Robust modified
# z-score over the per-(code,unit) distribution; no hardcoded clinical ranges.
TRUST_GATE_OUTLIER_MODZ=3.5
TRUST_GATE_OUTLIER_IQR_K=3.0
TRUST_GATE_OUTLIER_MIN_SAMPLE=20
# Seed for the reservoir sampler so the statistical outlier/drift advisory is
# reproducible across runs (Phase 1.5 determinism). The verdict itself never
# depends on these statistical checks (they are advisory-only).
TRUST_GATE_SAMPLER_SEED=1337
# Persisted cross-batch baseline for outlier detection (optional). Empty = the
# outlier check is stateless (batch-only, NA on small batches). `memory` keeps a
# process-local baseline; set a Postgres DSN for a durable, cross-replica one.
TRUST_GATE_BASELINE=
TRUST_GATE_BASELINE_DB_URL=
TRUST_GATE_BASELINE_RESERVOIR=500
# Platform persistence (optional). When set, the standalone Trust Gate retains
# every Quality Passport + per-check result so quality can be tracked, trended,
# and remediated over time (history/trend endpoints). Empty = stateless (assess
# still works, nothing retained). Use the Postgres DSN when scaling the service
# (`--scale trust-gate=N`); the SQLite path is single-instance / dev only.
TRUST_GATE_STORE_DB_URL=
TRUST_GATE_STORE_DB=
# SQL connector: comma-separated hostnames/IPs the connector may connect to.
# Set to "*" only in fully-trusted networks (e.g. same Docker network).
# Leave empty (default) to disable SQL connector entirely.
#   Examples: TRUST_GATE_SQL_ALLOWED_HOSTS=my-db.internal,192.168.1.5
#             TRUST_GATE_SQL_ALLOWED_HOSTS=*
TRUST_GATE_SQL_ALLOWED_HOSTS=
# SQL connector: hard cap on rows returned per query (default 20000).
TRUST_GATE_SQL_MAX_ROWS=20000
# Cross-batch distribution drift (plausibility.distribution_drift, consistency
# dimension): modified-z of the batch median vs the accumulated baseline. NA
# without a baseline (above).
TRUST_GATE_DRIFT_MODZ=3.5
# Timeliness / currency (NA until set — the gate does not invent "timely"):
#   record_lag = max acceptable event→record latency in days
#   currency   = freshness window in days vs provenance.extraction_time
TRUST_GATE_MAX_RECORD_LAG_DAYS=
TRUST_GATE_CURRENCY_WINDOW_DAYS=
# Salt for hashing PHI-bearing identifier values (e.g. MRN) before they appear in
# persisted passport audit details. Set a stable per-deployment secret.
TRUST_GATE_AUDIT_SALT=
# Audit profiles (selectable phases/sectors/intended-use) are managed via the
# anonymizer API at /v1/trust-profiles and forwarded to the gate per request;
# `phases`, `targets`, `intended_use`, and `reference` may also be passed inline.

# ── SMART on FHIR (optional) ──────────────────────────────────────────────────
# When SMART_INTROSPECTION_URL is set, the /auth/introspect endpoint proxies
# token introspection to an external authorization server. All other SMART
# well-known URLs are auto-derived from the anonymizer base URL unless overridden.
# Leave all blank to disable SMART (default — API-key auth or open mode is used).
SMART_INTROSPECTION_URL=
SMART_ISSUER=
SMART_AUTHORIZATION_URL=
SMART_TOKEN_URL=
SMART_JWKS_URL=
# JSON map of SMART scopes → internal RBAC roles.
# Example: {"system/*.read": "viewer", "system/*.write": "analyst", "system/admin": "admin"}
# SMART_SCOPE_ROLE_MAP=

# ── Web UI ───────────────────────────────────────────────────────────────────
# Port exposed on the host for the React browser UI.
UI_PORT=8501

# Optional API key for MedAnon. If set (non-empty), all endpoints except
# /health, /ready, /metrics, /docs require the X-API-Key header to match.
# Leave blank to disable authentication (default; suitable for local dev).
MEDANON_API_KEY=

# ── Authentication provider ───────────────────────────────────────────────────
# auto   — DB key → env key → SMART bearer → open access (legacy default)
# apikey — only X-API-Key accepted
# oidc   — OIDC JWT (Bearer) via Keycloak/Azure/Auth0 + optional X-API-Key
# none   — open access (all callers admin; LOCAL DEV ONLY)
MEDANON_AUTH_PROVIDER=auto
# Accept X-API-Key alongside OIDC (lets CLI / service-to-service keep working
# during an OIDC rollout). Set false to make OIDC the only accepted credential.
MEDANON_AUTH_ALLOW_API_KEY=true


# ── TLS for the UI (REQUIRED for OIDC) ───────────────────────────────────────
# The SPA's PKCE login calls window.crypto.subtle, which browsers expose ONLY in
# a secure context (HTTPS, or http://localhost). The UI therefore serves HTTPS.
# TLS_SAN = the host(s)/IP the cert must be valid for — set this to the address
# users actually reach the UI on, or the browser cert warning won't match.
#   TLS_SAN=10.168.192.22            (single internal IP)
#   TLS_SAN="app.example.org 10.0.0.5"  (space-separated)
# A self-signed cert is auto-generated on first boot (persisted in the ui-certs
# volume). For production, drop a CA-signed tls.crt/tls.key into /etc/nginx/certs.
TLS_SAN=localhost 127.0.0.1

# ── OIDC (Keycloak / Azure AD / Auth0) — required when MEDANON_AUTH_PROVIDER=oidc
# OIDC_ISSUER is the PUBLIC, browser-facing realm URL over HTTPS. It MUST equal
# the `iss` claim in tokens AND be reachable from the browser. With the bundled
# TLS nginx /auth/ proxy this is same-origin, e.g.:
#   OIDC_ISSUER=https://10.168.192.22:8501/auth/realms/medanon
#   OIDC_ISSUER=https://app.example.org/auth/realms/medanon
OIDC_ISSUER=
OIDC_CLIENT_ID=medanon-ui
OIDC_SCOPE=openid profile email
#
# SPLIT-HORIZON (Keycloak behind the proxy): the browser uses the public
# OIDC_ISSUER above, but the anonymizer CONTAINER reaches Keycloak on the
# internal Docker network. The backend cannot fetch JWKS from the public URL,
# so point OIDC_JWKS_URL at the INTERNAL certs endpoint:
OIDC_JWKS_URL=
#   e.g. OIDC_JWKS_URL=http://medanon-keycloak:8080/auth/realms/medanon/protocol/openid-connect/certs
OIDC_DISCOVERY_BASE=
#
# Audience check. Leave blank to skip (Keycloak access tokens often omit the
# client_id in `aud`). Set to your client/API identifier to enforce it.
OIDC_AUDIENCE=
#
# Role mapping: dotted claim path + Keycloak-role → internal-role map.
# Internal roles: admin > analyst > viewer.
OIDC_ROLE_CLAIM_PATH=realm_access.roles
OIDC_ROLE_MAP={"medanon-admin":"admin","medanon-analyst":"analyst","medanon-viewer":"viewer"}
OIDC_USERNAME_CLAIM=preferred_username
OIDC_CLOCK_SKEW_SEC=10
# DENY-BY-DEFAULT: an authenticated user with NO mapped realm role is rejected
# with 403. Leave blank for that (production-safe for PHI). Set to "viewer" to
# instead grant every authenticated user read-only access.
OIDC_DEFAULT_ROLE=

# ── Keycloak server (docker compose --profile auth) ──────────────────────────
# Reached ONLY through the UI's TLS edge at https://<host>:8501/auth/ (no host
# port is published). KEYCLOAK_PUBLIC_URL becomes Keycloak's KC_HOSTNAME.
# IMPORTANT: this is the full public base URL INCLUDING /auth — KC 26 uses this
# path verbatim when building issued URLs (issuer, authorization/token endpoints).
# It is the SAME path the server serves under (KC_HTTP_RELATIVE_PATH), NOT
# concatenated, so there is no /auth/auth. MUST be HTTPS and equal OIDC_ISSUER's
# base (everything before /realms/...). Origin-only (no /auth) drops /auth from
# the advertised endpoints and breaks the login redirect.
# Admin console: https://<host>:8501/auth/admin/
#   KEYCLOAK_PUBLIC_URL=https://10.168.192.22:8501/auth
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── HAPI FHIR PostgreSQL ────────────────────────────────────────────────────
# PostgreSQL database backing the HAPI FHIR server (persistent storage).
# Generate with: openssl rand -base64 24
HAPI_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
HAPI_DB_USER=hapi
HAPI_DB_NAME=hapi

# ── HAPI FHIR Target PostgreSQL (de-identified data store) ────────────────
# Separate PostgreSQL instance backing the target HAPI FHIR server.
# Physical separation ensures identified and de-identified data never share a database.
# Generate with: openssl rand -base64 24
HAPI_TARGET_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
HAPI_TARGET_DB_USER=hapi
HAPI_TARGET_DB_NAME=hapi_target
HAPI_TARGET_SERVER_ADDRESS=http://localhost:8082/fhir

# ── gPAS PostgreSQL ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 24
GPAS_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
#GPAS_DB_USER=gpas_user

# ── Scaling ───────────────────────────────────────────────────────────────────
# gPAS and NLP always run as single instances — additional replicas do not
# improve single-job latency. Tune MEDANON_BATCH_SIZE and sub-batch parallelism
# (GPAS_SUBBATCH_PARALLEL, NLP_CLIENT_SUBBATCH_PARALLEL) instead.
#
# Worker replicas: each is a separate Python process — GIL-free parallelism
# for running multiple jobs concurrently.
WORKER_REPLICAS=2

# ── Port mappings ─────────────────────────────────────────────────────────────
ANONYMIZER_PORT=8000
HAPI_PORT=8081
HAPI_TARGET_PORT=8082
GPAS_PORT=8080
# Microservice ports
ANALYTICS_PORT=8100
NLP_PORT=8200
# Scale NLP: docker compose up --scale nlp=2  (deploy.replicas is Swarm-only)

# ── Redis (shared cache + job queue) ──────────────────────────────────────────
# When set, Redis is used for BOTH:
#   1. L2 gPAS pseudonym cache (cross-replica sharing)
#   2. Scalable job queue (BLPOP event-driven worker instead of SQLite polling)
# Leave empty to use per-process LRU cache + SQLite job store (default).
# Docker-internal DNS: redis://redis:6379/0
# MEDANON_REDIS_PASSWORD is used by the Redis container (--requirepass) and must
# match the password embedded in MEDANON_REDIS_URL.
# Generate a random password: openssl rand -base64 24
MEDANON_REDIS_PASSWORD=           # REQUIRED — set to generated password before first start
MEDANON_REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

# ── Application database (PostgreSQL) ─────────────────────────────────────────
# PostgresJobStore (LISTEN/NOTIFY event-driven) + two-phase staging layer.
# docker-compose.yml auto-constructs MEDANON_APP_DB_URL from the password below,
# so you only need to set MEDANON_APP_DB_PASSWORD.  Override the full URL only
# if you use an external Postgres instance.
# Generate a password: openssl rand -base64 24
MEDANON_APP_DB_PASSWORD=medanon_dev  # Change before production deployment
# MEDANON_APP_DB_URL=postgresql://medanon:CHANGE_ME@app-db:5432/medanon  # override only for external DB

# ── SQL source de-identification (read-only ingest from external databases) ───
# De-identify selected tables of an external PostgreSQL DB to downloadable files.
# Connections are read-only and restricted to an explicit host allow-list
# (comma-separated; entries beginning with "." match any subdomain). An empty
# list denies all connections (secure default).
# MEDANON_SQL_SOURCE_ALLOWED_HOSTS=app-db,localhost,.internal.example.com
# Fernet key used to encrypt saved connection passwords at rest (required to save
# or use SQL source connections). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MEDANON_SQL_CRED_KEY=
# Optional connect/statement timeouts for source connections:
# MEDANON_SQL_SOURCE_CONNECT_TIMEOUT_SEC=10
# MEDANON_SQL_SOURCE_STATEMENT_TIMEOUT_MS=60000
#
# Opt-in TEST database (synthetic PII) for trying the feature out:
#   docker compose --profile sqltest up -d sql-source-test-db
# Then allow its hostname and connect from the UI with the credentials below.
#   MEDANON_SQL_SOURCE_ALLOWED_HOSTS=app-db,sql-source-test-db
# SQL_TEST_DB_PASSWORD=clinic_dev   # user: clinic  db: clinicdb
# SQL_TEST_PORT=55432               # host port for psql access (internal host: sql-source-test-db:5432)

# ── Async job queue ────────────────────────────────────────────────────────────
# Maximum concurrent job workers per anonymizer instance.
# With gunicorn multi-process (MEDANON_WORKERS), each process runs this many
# concurrent jobs. Total = MEDANON_WORKERS × MEDANON_JOB_WORKERS.
MEDANON_JOB_WORKERS=3
# Filesystem path for the SQLite job database (fallback when Redis is unavailable).
MEDANON_JOB_DB=/output/jobs.db
# Directory where completed async job NDJSON results are written.
MEDANON_OUTPUT_DIR=/output
# Result storage backend: 'local' (default) or 's3' (MinIO/S3-compatible).
# 'local' writes NDJSON to MEDANON_OUTPUT_DIR — single-replica only.
# 's3'    uploads to MinIO so every replica can serve results regardless of
#         which one processed the job. Requires 'docker compose --profile s3 up'.
MEDANON_RESULT_STORAGE=local
# Auto-cleanup: delete results older than this many seconds (default: 7 days).
# Set to 0 to disable automatic cleanup (files accumulate until manually removed).
MEDANON_RESULT_TTL_SEC=604800
# How often the cleanup loop runs (default: every hour). No effect when TTL=0.
MEDANON_RESULT_CLEANUP_INTERVAL_SEC=3600
# MinIO / S3 configuration (only used when MEDANON_RESULT_STORAGE=s3).
# MINIO_ENDPOINT=minio:9000
# MINIO_ROOT_USER=           # REQUIRED when s3 — set a unique username
# MINIO_ROOT_PASSWORD=       # REQUIRED when s3 — generate: openssl rand -hex 16
# MINIO_BUCKET=medanon-results
# MINIO_SECURE=false               # set true when MinIO uses TLS
# MinIO host ports (console UI available at http://localhost:9001 when profile=s3)
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# How often (in resources) the worker writes a progress checkpoint to the job store.
MEDANON_PROGRESS_INTERVAL=100
# How often (in resources) the staging checkpoint writer flushes cursor state.
MEDANON_CHECKPOINT_INTERVAL=100

# ── Parallelism / throughput tuning ───────────────────────────────────────────
# Parallel FHIR resource-type fetch threads during bulk-export (1 = sequential).
# Each thread holds one page (FHIR_PAGE_SIZE resources) in memory simultaneously.
MEDANON_FHIR_FETCH_PARALLEL=4
# Parallel $everything threads during cohort export.
MEDANON_COHORT_PARALLEL=4
# Parallel download threads for bulk-export NDJSON file downloads.
MEDANON_BULK_DOWNLOAD_PARALLEL=1
# Number of pre-fetched processing batches buffered ahead of the consumer
# (pipelines FHIR I/O with de-identification CPU work). 0 = sequential fallback.
MEDANON_PREFETCH_BATCHES=2
# Resources per gPAS batch in the in-memory pipeline (1 gPAS HTTP call per batch).
# Larger values reduce the number of round-trips to gPAS on cold cache.
MEDANON_BATCH_SIZE=1000
# Maximum values per single gPAS HTTP call. Larger batches are fewer HTTP round-trips.
# When a batch exceeds this limit the remainder is split into parallel sub-batches.
GPAS_MAX_BATCH_SIZE=2000
# ── Connection Pool Budget ──────────────────────────────────────────────────
# Global connection budget across all subsystems (gPAS HTTP, FHIR HTTP,
# proxy HTTP, PostgreSQL app, PostgreSQL staging). Each subsystem gets a
# proportional share unless overridden by its own env var.
# app-db max_connections should be >= this value (docker-compose sets 200).
MEDANON_GLOBAL_MAX_CONNECTIONS=100
# gPAS HTTP connection pool size. Default: 30% of global budget.
# Set explicitly to override. Rule of thumb: JOB_WORKERS × max_sub_batches_per_job.
GPAS_POOL_SIZE=24
# DEPRECATED: GPAS_PARALLEL_BATCHES no longer controls max_workers directly.
# Concurrency is now governed by MEDANON_GLOBAL_MAX_THREADS (see below).
GPAS_PARALLEL_BATCHES=10
# Process-wide thread budget shared by gPAS sub-batches, FHIR fetch, upload,
# and Pass 1 parallelism. Prevents thread explosion when multiple jobs run
# concurrently. Default 64 supports parallel Pass 1 (8-16 threads each).
MEDANON_GLOBAL_MAX_THREADS=64
# Max pending tasks beyond active workers before submit() blocks (backpressure).
# Default: MEDANON_GLOBAL_MAX_THREADS × 2.  Caps in-flight chunk data under overload.
MEDANON_POOL_QUEUE_DEPTH=128
# Checkpoint/progress updates are saved every N resources processed.
# Higher values reduce DB I/O overhead but lose more progress on crash.
MEDANON_PROGRESS_INTERVAL=500
# Enable producer-consumer pipeline (overlaps FHIR fetch with processing).
# Set to false to revert to sequential chunk processing (debugging).
MEDANON_PIPELINE_ENABLED=true
# Number of pre-fetched chunks buffered in the producer-consumer pipeline.
# Higher values hide more fetch latency but use more memory.
MEDANON_PIPELINE_QUEUE_SIZE=4
FHIR_POOL_SIZE=10
# Pool size for general proxy/analytics/NLP HTTP client (http_client.py).
PROXY_POOL_SIZE=16
PROXY_RETRY_COUNT=2
PROXY_RETRY_BACKOFF_SEC=0.3
# Connect timeout (seconds) for all proxy_* HTTP calls.  Read timeout is
# per-call (e.g. NLP_BATCH_TIMEOUT_SEC, gpas_timeout_sec).
PROXY_TIMEOUT_CONNECT_SEC=5

# ── Per-upstream bulkheads (utils/bulkhead) ────────────────────────────────
# Cap concurrent in-flight calls per upstream so a slow service can never
# starve capacity needed by the others.  When saturated, callers get HTTP 503
# (gPAS) or fall back to [NLP_UNAVAILABLE] (NLP).
BULKHEAD_GPAS_MAX_CONCURRENT=32
BULKHEAD_NLP_MAX_CONCURRENT=16
BULKHEAD_FHIR_MAX_CONCURRENT=16
BULKHEAD_ANALYTICS_MAX_CONCURRENT=8
BULKHEAD_SCORING_MAX_CONCURRENT=16
BULKHEAD_AI_MAX_CONCURRENT=4
# Brief wait (seconds) before fast-failing on saturation; absorbs micro-bursts.
BULKHEAD_GPAS_WAIT_SEC=2
BULKHEAD_NLP_WAIT_SEC=1

# ── Redis durability ───────────────────────────────────────────────────────
# When true, the anonymizer refuses to start if MEDANON_REDIS_URL is set but
# Redis AOF persistence is disabled.  Recommended in production to avoid job
# loss across an unexpected Redis restart.
MEDANON_REQUIRE_REDIS_AOF=false

# ── FHIRPath cache tuning (pipeline/rule_matcher.py) ───────────────────────
# Per-cache LRU sizes.  Sampled into Prometheus on /metrics scrape; raise the
# size when medanon_fhirpath_cache_misses grows while size == maxsize.
FHIRPATH_CACHE_SIZE=512
FHIRPATH_CLASSIFY_CACHE_SIZE=256
FHIRPATH_WHERE_CACHE_SIZE=128
FHIRPATH_CANDIDATES_CACHE_SIZE=512
# Processing timeout per request (seconds). Returns HTTP 504 when exceeded.
# Timeout cascade: UI nginx (120s) > gunicorn (90s) > downstream services.
# Long-running operations should use the async job queue (/v1/jobs/*).
MEDANON_REQUEST_TIMEOUT_SEC=90
# Timeout (seconds) waiting for the next resource from the FHIR pagination queue.
MEDANON_QUEUE_GET_TIMEOUT_SEC=300

# ── Upload (bulk-import job) ────────────────────────────────────────────────
# Resources per FHIR batch Bundle when uploading to a target FHIR server.
MEDANON_UPLOAD_BATCH_SIZE=500
# Concurrent FHIR batch Bundle POSTs per topological tier during bulk-import.
# Higher values speed up upload but increase memory and FHIR server load.
MEDANON_UPLOAD_PARALLEL=4

# ── Config profiles ────────────────────────────────────────────────────────────
# Directory containing built-in YAML rule profiles (default: /code/config in container).
# MEDANON_CONFIG_DIR=/code/config
# Directory for user-uploaded custom YAML profiles (persisted across restarts).
MEDANON_USER_CONFIG_DIR=/output/user-configs
# SQLite database backing the config profile store (user-created/updated profiles).
MEDANON_CONFIG_STORE_DB=/output/config_store.db
# TTL in seconds for the config LRU cache (0 = never expire, reload only on restart).
# Set to a low value (e.g. 30) when hot-editing YAML profiles without restarting.
MEDANON_CONFIG_CACHE_TTL=0

# ── Staging (large-scale bulk-export / cohort — Phase 1 fetch + Phase 2 process) ──
# Set to a PostgreSQL DSN to enable the two-phase staged pipeline.
# Uses the existing hapi-postgres container; leave empty to keep the streaming fallback.
# Docker-internal DSN: postgresql://hapi:<HAPI_DB_PASSWORD>@hapi-db:5432/hapi
MEDANON_STAGING_DB_URL=
# How many days to keep staging rows before they are deleted by the cleanup loop (0 = never).
MEDANON_STAGING_RETENTION_DAYS=30
# Resources per gPAS batch in Phase 2 processing (each batch = 1 gPAS HTTP call).
# Increase for large exports: 2000 halves the number of gPAS prefetch round-trips
# (130K resources = 65 batches instead of 130, saves ~13 s at 200 ms/call).
# Requires MEDANON_CACHE_MAX_ENTRIES large enough to hold the larger working set.
MEDANON_STAGING_BATCH_SIZE=1000
# Phase-2 parallel worker count (threads, or processes when EXECUTOR=process).
# Default 4: the FHIRPath match stage (~99% of engine CPU on warm caches) scales
# ~3x on threads then plateaus on the GIL — see tests/perf/bench_pipeline.py.
MEDANON_STAGING_PROCESS_WORKERS=4
# Phase-2 executor: "thread" (default, in-process, overlaps gPAS/NLP I/O +
# partial-GIL FHIRPath) or "process" (separate processes, bypasses the GIL
# plateau; measured ~2x faster on a warm-cache 131K export).
MEDANON_STAGING_EXECUTOR=thread
# With EXECUTOR=process, jobs with fewer partitions than this fall back to
# threads (process startup + per-child FHIRPath compile not worth it when small).
MEDANON_STAGING_PROCESS_MIN_PARTITIONS=4
# Phase-2 re-fetch _id batch size (B2): larger = fewer round-trips per group.
MEDANON_FHIR_REFETCH_CHUNK=200
# Opt-in encrypted body staging (A1). Default (unset/false) = refs-only, zero PHI
# at rest, Phase 2 re-fetches from FHIR. Set to `encrypted` to instead persist each
# resource body GZIP+Fernet-encrypted (AES-128-CBC+HMAC) so Phase 2 decrypts
# in-process and skips the re-fetch. Requires MEDANON_STAGE_BLOB_KEY (fail-closed).
MEDANON_STAGE_BODIES=
# Fernet key for MEDANON_STAGE_BODIES=encrypted. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDANON_STAGE_BLOB_KEY=
# Export routing (C1): auto (default, size-threshold) | staged (always partition;
# crash-resume + multi-pod scale-out) | stream (always single-fetch; fetch once,
# process once, cursor-checkpoint resume; best single-pod throughput).
MEDANON_EXPORT_MODE=auto
# How often (in seconds) the staging cleanup loop runs to delete expired rows.
MEDANON_STAGING_CLEANUP_INTERVAL_SEC=3600
# How often (in seconds) the worker scans for staged rows stuck in
# `processing` state (e.g. after a worker crash) and resets them to `pending`.
# Set to 0 to disable. Default 300 s = 5 min.
MEDANON_STALE_RECOVERY_INTERVAL_SEC=300
# Rows in `processing` older than this many minutes are reclaimed.
# Should comfortably exceed your longest expected single-batch processing time.
# Also bounds Redis-Streams job recovery: at startup a worker only reclaims PEL
# messages idle longer than this (NEVER min_idle=0), so a freshly-booted replica
# cannot steal a job still running on a sibling worker.
MEDANON_STALE_RECOVERY_TIMEOUT_MIN=10
# How often (seconds) a worker refreshes the Redis-Streams claim for jobs it is
# actively running, so a long job's idle timer never crosses the stale timeout
# above (prevents reclaim → concurrent double-run). Must be well below the
# timeout. Set 0 to disable. Default 30 s.
MEDANON_CLAIM_HEARTBEAT_SEC=30

# ── Job-queue backpressure ────────────────────────────────────────────────────
# Max pending jobs allowed before /v1/jobs/* submit endpoints return HTTP 503
# with a Retry-After header.  Set to 0 to disable (load-test mode).
# Default of 200 = ~67x the per-pod MEDANON_JOB_WORKERS=3 capacity, plenty of
# headroom for bursts but bounded so the queue cannot grow unboundedly.
MEDANON_MAX_PENDING_JOBS=200
# Value sent in the `Retry-After:` header when the queue is full (seconds).
MEDANON_QUEUE_FULL_RETRY_AFTER=60

# ── Subscriptions ─────────────────────────────────────────────────────────────
# SQLite database path for FHIR Subscription state (created automatically).
MEDANON_SUBSCRIPTION_DB=/output/subscriptions.db
# Timeout (seconds) for outbound webhook delivery on subscription notifications.
SUBSCRIPTION_WEBHOOK_TIMEOUT=10

# ── DICOM ─────────────────────────────────────────────────────────────────────
# Maximum request body size for the /process/dicom endpoint (default 50 MB).
# Larger than the general MEDANON_MAX_BODY_BYTES because DICOM files can be large.
DICOM_MAX_BODY_BYTES=52428800

# ── Microservice opt-outs (Phase 3 strangler fig) ─────────────────────────────
# ANALYTICS_SERVICE_URL is hardwired to http://analytics:8100 in docker-compose.yml
# (analytics container is always started alongside the anonymizer).
# Only override here if pointing at an external analytics deployment.
ANALYTICS_SERVICE_URL=

# NLP_SERVICE_URL is hardwired to http://nlp-lb:8200 in docker-compose.yml
# (NLP service always starts alongside the anonymizer).
# Only override here if pointing the anonymizer at an external NLP deployment.
NLP_SERVICE_URL=

# NLP circuit breaker — prevents cascading failures when NLP service is down.
# When open, NLP scrubbing is skipped (PHI leak risk — logged as warnings).
NLP_CB_FAILURE_THRESHOLD=5
NLP_CB_RECOVERY_TIMEOUT_SEC=60
NLP_CB_WINDOW_SEC=120

# NLP L2 cache (Redis) — shared across NLP replicas, survives restarts.
# Eliminates the "cold cache" cost on deploy. Defaults to the in-stack Redis
# on DB 2 (DB 0 = anonymizer L2, DB 1 = job queue). Leave empty to disable
# and run NLP with L1 (in-process LRU, ~20k entries) only.
NLP_REDIS_URL=
NLP_REDIS_TTL_SEC=604800

# ── gPAS MySQL replication (opt-in HA profile) ────────────────────────────────
# Password for the MySQL replication user created during the one-time replication setup.
# Only required when starting with: docker compose --profile ha up
# Generate with: openssl rand -base64 24
GPAS_REPL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Audit log ─────────────────────────────────────────────────────────────────
# Structured audit log (inside container; maps to ./output/audit.log on host).
MEDANON_AUDIT_LOG_FILE=/output/audit.log
# Maximum audit log file size before rotation (bytes, default 10 MB).
MEDANON_AUDIT_LOG_MAX_BYTES=10485760
# Number of rotated audit log backups to keep.
MEDANON_AUDIT_LOG_BACKUP_COUNT=5
# Async audit sinks (F.18): when true, the slow Redis Stream + S3 audit writes
# move to a bounded background queue so they stay off the request hot path. The
# authoritative stdout JSON line is always written synchronously, so a full
# queue degrades durability (lag) but never loses the primary record.
MEDANON_AUDIT_ASYNC=false
# Max events buffered before a full queue falls back to a synchronous write
# (and increments medanon_audit_dropped_total).
MEDANON_AUDIT_QUEUE_MAX=10000

# ── AI Agent Integration ──────────────────────────────────────────────────────
# Master switch — when false, all /v1/ai/ endpoints return 501.
# To enable AI fully with the bundled local Ollama:
#   1) set MEDANON_AI_ENABLED=true here
#   2) run `make ai-up`  (starts the stack + Ollama, pulls the model, verifies)
MEDANON_AI_ENABLED=false
# litellm model string — e.g. ollama/llama3.1, gpt-4o, claude-sonnet-4-20250514
# The part after "ollama/" is the model tag `make ai-pull` downloads.
MEDANON_AI_PROVIDER=ollama/llama3.1
# Base URL for the LLM provider. Default targets the bundled `ollama` compose
# service (started by `make ai-up` / `docker compose --profile ai up`).
# Override to point at a remote Ollama VM or a cloud API.
MEDANON_AI_API_BASE=http://ollama:11434
# API key for cloud providers (empty for Ollama).
MEDANON_AI_API_KEY=
# Generation temperature (lower = more deterministic).
MEDANON_AI_TEMPERATURE=0.2
# Max response tokens.
MEDANON_AI_MAX_TOKENS=4096
# Ollama context window. The few-shot config-generation prompt is ~8.4k tokens
# plus the user request and response budget; Ollama's default (2048) — and even
# 8192 — silently truncate it and produce empty output. 16384 fits the full
# prompt with headroom for the generated YAML.
MEDANON_AI_NUM_CTX=16384
# Request timeout in seconds.
MEDANON_AI_TIMEOUT_SEC=60
# Circuit breaker: failures before tripping.
MEDANON_AI_CB_FAILURE_THRESHOLD=3
# Circuit breaker: seconds before trying again after trip.
MEDANON_AI_CB_RECOVERY_TIMEOUT_SEC=60
# Response caching.
MEDANON_AI_CACHE_ENABLED=true
# Cache TTL in seconds (how long AI responses are reused before re-querying the LLM).
MEDANON_AI_CACHE_TTL_SEC=3600
# Max cached AI responses (bounded LRU + proactive TTL eviction). Prevents the
# response cache from growing without bound under diverse prompts.
MEDANON_AI_CACHE_MAX_ENTRIES=256
# Override model for PII leak detection (must be local/self-hosted for PHI safety).
# Leave empty to skip AI-based PII detection (regex + NER still run).
MEDANON_AI_PII_PROVIDER=
# C4 local-only enforcement: when true (default) the PII model is verified to
# resolve to a loopback/private endpoint before any de-identified text is sent.
# If it can't be proven local the AI layer is skipped (fail-closed). Set to
# false only to deliberately opt out (NOT recommended — risks PHI exfiltration).
MEDANON_AI_PII_REQUIRE_LOCAL=true
# Pin the PII model to a specific self-hosted endpoint (e.g. a local vLLM/Ollama
# gateway). An explicit loopback/private api_base satisfies the local-only check
# regardless of the model name. Leave empty to rely on provider-prefix routing.
MEDANON_AI_PII_API_BASE=
# Comma-separated extra provider prefixes treated as local (besides ollama/,
# ollama_chat/, vllm/, lm_studio/, local/). Example: mylocal/
MEDANON_AI_PII_LOCAL_PREFIXES=
# Comma-separated extra hostnames trusted as local without DNS resolution
# (besides ollama, localhost, host.docker.internal). Example: my-gpu-box
MEDANON_AI_LOCAL_HOSTS=
# Site-wide hard lock (C4): when true, EVERY LLM call (not just PHI scans) must
# resolve to a local/self-hosted endpoint — including config generation,
# explanation, and compliance. Default false; set true for hospital deployments
# that must never reach any external LLM.
MEDANON_AI_REQUIRE_LOCAL=false
# Raw-resource PII scan override. The output barrier is ON by default
# (MEDANON_OUTPUT_GATE_ENABLED); set MEDANON_PII_GATE=false to opt the raw scan
# out individually (the score-summary gate still runs).
MEDANON_PII_GATE=false
# Severities the output gate hard-blocks on (comma-separated). Default
# "critical,high" blocks names/SSN/MRN AND phone/email/street address — all
# HIPAA Safe Harbor direct identifiers. Add "medium" for strict Safe Harbor
# (also blocks bare ISO dates + IPs; will false-positive on date-shift pipelines
# that legitimately retain day-precision dates). Set "critical" for the legacy
# names/SSN/MRN-only behaviour.
MEDANON_PII_GATE_BLOCK_SEVERITY=critical,high
# Strangler-fig: when set, all /v1/ai/ requests proxy to this URL.
AI_SERVICE_URL=
# SSRF posture for the AI proxy (C6): AI_SERVICE_URL is admin-set config and may
# legitimately point at an in-cluster private address, so private nets are
# allowed by default. Link-local/metadata ranges (169.254.0.0/16) and non-http
# schemes are ALWAYS rejected. Set false to also forbid private/loopback.
MEDANON_AI_PROXY_ALLOW_PRIVATE=true

# ── Distributed Tracing (Jaeger) ──────────────────────────────────────────
# Start with: docker compose --profile monitoring up -d
# View traces: http://localhost:16686
MEDANON_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
JAEGER_UI_PORT=16686
